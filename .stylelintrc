{
 "extends": ["stylelint-config-recommended-scss"],
 "rules": {
    "selector-class-pattern": "^.[a-z]([a-z0-9-]+)?(__([a-z0-9]+-?)+)?(--([a-z0-9]+-?)+){0,2}$",
        "indentation": 2,
    "color-hex-case": "lower",
    "color-hex-length": "short",
    "comment-no-empty": true,
    "max-empty-lines": 1,
    "max-line-length": 120,
    "max-nesting-depth": 3,
    "scss/at-import-partial-extension": "never",
    "block-no-empty": true
 }
}